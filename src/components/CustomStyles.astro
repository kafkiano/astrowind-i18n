---
import '@fontsource-variable/inter';
import '@fontsource-variable/cairo';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(83 166 244);
    --aw-color-secondary: rgb(255 18 127);
    --aw-color-accent: rgb(0 239 209);

    --aw-color-text-heading: rgb(0 0 0);
    --aw-color-text-default: rgb(16 16 16);
    --aw-color-text-muted: rgb(16 16 16 / 66%);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(15 17 23);

    ::selection {
      background-color: rgb(83 166 244 / 20%);
    }
  }

  /* RTL (Arabic, etc.) — swap fonts and adjust typography */
  :dir(rtl) {
    --aw-font-sans: 'Cairo Variable';
    --aw-font-serif: 'Cairo Variable';
    --aw-font-heading: 'Cairo Variable';
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --aw-font-serif: 'Inter Variable';
    --aw-font-heading: 'Inter Variable';

    --aw-color-primary: rgb(109 185 255);
    --aw-color-secondary: rgb(255 80 160);
    --aw-color-accent: rgb(0 239 209);

    --aw-color-text-heading: rgb(247 248 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(15 17 23);

    ::selection {
      background-color: rgb(109 185 255 / 25%);
      color: rgb(255 255 255);
    }
  }

  .dark:dir(rtl) {
    --aw-font-sans: 'Cairo Variable';
    --aw-font-serif: 'Cairo Variable';
    --aw-font-heading: 'Cairo Variable';
  }
</style>
