---
import type { HTMLAttributes } from 'astro/types';
import { findImage } from '~/utils/images';
import {
  getImagesOptimized,
  astroAssetsOptimizer,
  unpicOptimizer,
  isUnpicCompatible,
  type ImageProps,
} from '~/utils/images-optimization';

type Props = ImageProps;
type ImageType = {
  src: string;
  attributes: HTMLAttributes<'img'>;
};

const props = Astro.props;

if (props.alt === undefined || props.alt === null) {
  throw new Error();
}

if (typeof props.width === 'string') {
  props.width = parseInt(props.width);
}

if (typeof props.height === 'string') {
  props.height = parseInt(props.height);
}

if (!props.loading) {
  props.loading = 'lazy';
}

if (!props.decoding) {
  props.decoding = 'async';
}

const _image = await findImage(props.src);

let image: ImageType | undefined = undefined;

if (
  typeof _image === 'string' &&
  (_image.startsWith('http://') || _image.startsWith('https://')) &&
  isUnpicCompatible(_image)
) {
  image = await getImagesOptimized(_image, props, unpicOptimizer);
} else if (_image) {
  image = await getImagesOptimized(_image, props, astroAssetsOptimizer);
}

// Fix base path for public/ images — they bypass Astro's asset pipeline
// so getImage() doesn't prepend BASE_URL automatically.
// Asset images (from ~/assets/) already have the base path from getImage().
const BASE_URL = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
if (image) {
  const fixPath = (url: string) =>
    url.startsWith('/') && !url.startsWith('http') && !url.startsWith(BASE_URL + '/') ? BASE_URL + url : url;

  image.src = fixPath(image.src);
  if (image.attributes.srcset) {
    image.attributes.srcset = image.attributes.srcset
      .split(', ')
      .map((entry) => {
        const parts = entry.split(' ');
        parts[0] = fixPath(parts[0]);
        return parts.join(' ');
      })
      .join(', ');
  }
}
---

{
  !image ? (
    <Fragment />
  ) : (
    <img src={image.src} crossorigin="anonymous" referrerpolicy="no-referrer" {...image.attributes} />
  )
}
