---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

export interface Props {
  /** Content entry from getEntry() */
  content?: CollectionEntry<'snippets'> | undefined;
  /** Inline markdown string (for simple cases) */
  inline?: string;
}

const { content, slug, inline } = Astro.props;
const locale = Astro.currentLocale ?? I18N.defaultLocale;

let entry = content;
if (!entry && slug) {
  const entryId = `${locale}/${slug}`;
  entry = await getEntry('snippets', entryId);
}

let Content: AstroComponentFactory | null = null;

if (content) {
  const rendered = await render(content);
  Content = rendered.Content;
}
---

{Content && <Content />}
{inline && <Fragment set:html={inline} />}
