---
import FeatureCard from '~/components/ui/FeatureCard.astro';
import Slider from '~/components/widgets/Slider.astro';
import type { Item } from '~/types';

interface Props {
  items: Item[];
  columns?: number;
  defaultIcon?: string;
  autoplay?: number | false | { delay: number; disableOnInteraction?: boolean };
  pagination?: boolean;
  navigation?: boolean;
  loop?: boolean;
  classes?: Record<string, string>;
}

const {
  items = [],
  columns = 3,
  defaultIcon,
  autoplay,
  pagination = false,
  navigation = true,
  loop = true,
  classes = {},
} = Astro.props;
---

{
  items.length > 0 && (
    <Slider
      config={{
        columns,
        autoplay,
        loop,
        pagination,
        navigation,
      }}
    >
      {items.map(({ title, description, icon, callToAction }) => (
        <div class="embla-slide">
          <FeatureCard
            layout="horizontal"
            title={title}
            description={description}
            icon={icon}
            defaultIcon={defaultIcon}
            callToAction={callToAction}
            classes={{
              panel: `p-4 md:p-6 rounded-xl dark:border dark:border-slate-600 shadow-lg dark:shadow-none ${
                columns === 1 ? 'max-w-3xl mx-auto' : 'mx-4'
              }`,
              icon: 'text-white bg-primary rounded-full w-10 h-10 p-2 md:w-12 md:h-12 md:p-3 mr-4 rtl:ml-4 rtl:mr-0',
              ...classes,
            }}
          />
        </div>
      ))}
    </Slider>
  )
}
