---
import { getAsset } from '~/utils/permalinks';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Image from '~/components/common/Image.astro';
import type { Gallery as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  images = [],
  columns = 3,
  variant = 'grid',
  mobileVariant = 'expandable',
  pagination = false,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const isMasonry = variant === 'masonry';

const gridCols =
  columns === 4
    ? 'sm:grid-cols-2 lg:grid-cols-4'
    : columns === 3
      ? 'sm:grid-cols-2 lg:grid-cols-3'
      : columns === 2
        ? 'sm:grid-cols-2'
        : 'sm:grid-cols-2 lg:grid-cols-3';

const masonryCss = isMasonry ? 'grid grid-flow-dense items-start gap-4 ' + gridCols : 'grid gap-6 ' + gridCols;
const galleryId = `gallery-${crypto.randomUUID()}`;
const visibleMobileCount = 4;
const hasMobileExpand = mobileVariant === 'expandable' && images.length > visibleMobileCount;
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`max-w-7xl mx-auto ${(classes?.container as string) ?? ''}`}
  bg={bg}
>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={classes?.headline as Record<string, string>} />

  {
    images && images.length > 0 && (
      <>
        {/* Desktop + tablet grid (always visible from sm up) */}
        <div
          class:list={[
            masonryCss,
            (classes?.grid as string) ?? '',
            { 'hidden sm:grid': mobileVariant === 'expandable' || mobileVariant === 'peek' },
          ]}
          {...(isMasonry ? { 'data-masonry': 'balanced' } : {})}
          data-gallery-desktop
        >
          {images.map((image, index) => {
            const { src, alt, width, height, colSpan } = image;
            return (
              <figure
                class:list={[
                  'm-0 intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
                  isMasonry ? 'mb-4' : '',
                ]}
                data-src={src}
                data-alt={alt}
                data-width={width}
                data-height={height}
                data-col-span={colSpan && colSpan > 1 ? colSpan : undefined}
                data-index={index}
              >
                <div class="overflow-hidden rounded-xl shadow-lg dark:shadow-none dark:border dark:border-slate-700">
                  <Image
                    class={`w-full hover:scale-105 transition-transform duration-300 ${isMasonry ? 'h-auto' : 'h-64 object-cover'}`}
                    width={width || 400}
                    height={height || (isMasonry ? undefined : 256)}
                    widths={[400, 768, 1024]}
                    sizes={`(max-width: 639px) 100vw, (max-width: 1023px) 50vw, ${100 / columns}vw`}
                    layout="responsive"
                    loading={isMasonry ? 'eager' : undefined}
                    src={src}
                    alt={alt}
                  />
                </div>
              </figure>
            );
          })}
        </div>

        {/* Mobile expandable grid */}
        {mobileVariant === 'expandable' && (
          <>
            <div
              class:list={['grid grid-cols-1 gap-6 sm:hidden', (classes?.grid as string) ?? '']}
              data-gallery-mobile={galleryId}
              data-expanded="false"
            >
              {images.map((image, index) => {
                const { src, alt, width, height, colSpan } = image;
                const isHiddenInitially = index >= visibleMobileCount;
                return (
                  <figure
                    class:list={[
                      'm-0 intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade',
                      isMasonry ? 'mb-4' : '',
                      { hidden: isHiddenInitially },
                    ]}
                    data-src={src}
                    data-alt={alt}
                    data-width={width}
                    data-height={height}
                    data-col-span={colSpan && colSpan > 1 ? colSpan : undefined}
                    data-index={index}
                    data-gallery-hidden-item={isHiddenInitially ? '' : undefined}
                  >
                    <div class="overflow-hidden rounded-xl shadow-lg dark:shadow-none dark:border dark:border-slate-700">
                      <Image
                        class={`w-full hover:scale-105 transition-transform duration-300 ${isMasonry ? 'h-auto' : 'h-64 object-cover'}`}
                        width={width || 400}
                        height={height || (isMasonry ? undefined : 256)}
                        widths={[400, 768, 1024]}
                        sizes="100vw"
                        layout="responsive"
                        loading={isMasonry ? 'eager' : undefined}
                        src={src}
                        alt={alt}
                      />
                    </div>
                  </figure>
                );
              })}
            </div>

            {hasMobileExpand && (
              <div class="flex justify-center mt-4 sm:hidden">
                <button
                  type="button"
                  data-gallery-toggle={galleryId}
                  class="group inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-primary text-white text-sm font-medium transition hover:bg-secondary"
                  aria-expanded="false"
                  data-count={images.length - visibleMobileCount}
                >
                  <span data-gallery-more-text>Show {images.length - visibleMobileCount} more</span>
                  <span data-gallery-less-text class="hidden">
                    Show less
                  </span>
                  <svg
                    class="w-4 h-4 transition-transform group-aria-expanded:rotate-180"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <polyline points="6 9 12 15 18 9" />
                  </svg>
                </button>
              </div>
            )}
          </>
        )}

        {/* Mobile peek carousel */}
        {mobileVariant === 'peek' && (
          <div
            class="relative sm:hidden"
            id={galleryId}
            data-gallery-peek-id={galleryId}
            data-gallery-peek-config={JSON.stringify({
              loop: false,
              align: 'start',
              hasPagination: pagination,
            })}
          >
            <div class="embla-viewport overflow-hidden" data-gallery-peek-viewport>
              <div class="flex gap-4" data-gallery-peek-track>
                {images.map((image, index) => {
                  const { src, alt, width, height, colSpan } = image;
                  return (
                    <figure
                      class:list={['m-0 embla-slide feature-slide', 'flex-[0_0_85%] min-w-0', isMasonry ? 'mb-4' : '']}
                      data-src={src}
                      data-alt={alt}
                      data-width={width}
                      data-height={height}
                      data-col-span={colSpan && colSpan > 1 ? colSpan : undefined}
                      data-index={index}
                    >
                      <div class="overflow-hidden rounded-xl shadow-lg dark:shadow-none dark:border dark:border-slate-700">
                        <Image
                          class={`w-full hover:scale-105 transition-transform duration-300 ${isMasonry ? 'h-auto' : 'h-64 object-cover'}`}
                          width={width || 400}
                          height={height || (isMasonry ? undefined : 256)}
                          widths={[400, 768, 1024]}
                          sizes="85vw"
                          layout="responsive"
                          loading={isMasonry ? 'eager' : undefined}
                          src={src}
                          alt={alt}
                        />
                      </div>
                    </figure>
                  );
                })}
              </div>
            </div>

            {pagination && <div data-gallery-peek-dots class="flex justify-center gap-2 mt-3" />}
          </div>
        )}
      </>
    )
  }
</WidgetWrapper>

<script is:inline>
  (function () {
    function initExpandableGalleries() {
      document.querySelectorAll('[data-gallery-toggle]').forEach((button) => {
        /** @type {HTMLElement} */
        const btn = button;
        if (btn.dataset.awInitialized) return;
        btn.dataset.awInitialized = 'true';

        const galleryId = btn.dataset.galleryToggle;
        /** @type {HTMLElement | null} */
        const container = document.querySelector(`[data-gallery-mobile="${galleryId}"]`);
        if (!container) return;

        const hiddenItems = container.querySelectorAll('[data-gallery-hidden-item]');
        const moreText = btn.querySelector('[data-gallery-more-text]');
        const lessText = btn.querySelector('[data-gallery-less-text]');

        btn.addEventListener('click', () => {
          const expanded = container.getAttribute('data-expanded') === 'true';

          if (!expanded) {
            hiddenItems.forEach((item) => {
              item.classList.remove('hidden');
              item.classList.add('motion-safe:animate-fadeIn');
            });
            container.setAttribute('data-expanded', 'true');
            btn.setAttribute('aria-expanded', 'true');
            moreText?.classList.add('hidden');
            lessText?.classList.remove('hidden');
          } else {
            hiddenItems.forEach((item) => {
              item.classList.add('hidden');
              item.classList.remove('motion-safe:animate-fadeIn');
            });
            container.setAttribute('data-expanded', 'false');
            btn.setAttribute('aria-expanded', 'false');
            moreText?.classList.remove('hidden');
            lessText?.classList.add('hidden');
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initExpandableGalleries);
    } else {
      initExpandableGalleries();
    }
    document.addEventListener('astro:after-swap', initExpandableGalleries);
  })();
</script>

<script>
  import { registerEmblaSliders } from '~/utils/embla';

  registerEmblaSliders(
    '[data-gallery-peek-config]',
    '[data-gallery-peek-viewport]',
    'gallery-peek-initialized',
    '[data-gallery-peek-dots]',
    {
      getConfig: (el) => JSON.parse(el.dataset.galleryPeekConfig || '{}'),
      getOptions: (config) => ({ loop: config.loop, align: config.align || 'start' }),
      prevSelector: '[data-gallery-peek-prev]',
      nextSelector: '[data-gallery-peek-next]',
    }
  );
</script>

<style is:inline>
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fadeIn {
    animation: fadeIn 0.3s ease-out both;
  }
</style>

{isMasonry && <script is:inline src={getAsset('assets/scripts/masonry-polyfill.js')} async />}
