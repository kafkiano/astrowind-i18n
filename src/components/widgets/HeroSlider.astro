---
import HeroTextBlock from '~/components/ui/HeroTextBlock.astro';
import Image from '~/components/common/Image.astro';
import Slider from '~/components/widgets/Slider.astro';
import type { CallToAction, Image as ImageType } from '~/types';

interface HeroSlide {
  image: ImageType;
  title?: string;
  subtitle?: string;
  actions?: (string | CallToAction)[];
}

interface Props {
  tagline?: string;
  slides: HeroSlide[];
  autoplay?: number | false | { delay: number; disableOnInteraction?: boolean };
  sliderPagination?: boolean;
  sliderNavigation?: boolean;
  id?: string;
}

const { tagline, slides = [], autoplay = 5000, sliderPagination, sliderNavigation, id } = Astro.props;

const hasPagination = sliderPagination ?? slides.length > 1;
const hasNavigation = sliderNavigation ?? slides.length > 1;
---

{
  slides.length > 0 && (
    <section class="relative not-prose" {...(id ? { id } : {})}>
      <Slider
        config={{
          autoplay,
          loop: true,
          effect: 'fade',
          slidesPerView: 1,
          gap: 0,
          pagination: hasPagination,
          navigation: hasNavigation,
        }}
        class="h-[600px] md:h-[700px] lg:h-screen"
      >
        {slides.map((slide) => (
          <div class="embla-slide relative flex items-center justify-center overflow-hidden">
            <div class="absolute inset-0">
              <Image
                src={slide.image.src}
                alt={slide.image.alt || ''}
                widths={[400, 768, 1024, 2040]}
                sizes="100vw"
                loading="eager"
                class="w-full h-full object-cover"
                width={2040}
                height={1200}
                {...(typeof slide.image === 'object' ? slide.image : {})}
              />
            </div>
            <div class="relative z-10 text-center px-4 sm:px-6 max-w-5xl mx-auto">
              <HeroTextBlock
                title={slide.title}
                subtitle={slide.subtitle}
                tagline={tagline}
                actions={slide.actions}
                align="center"
              />
            </div>
          </div>
        ))}
      </Slider>
    </section>
  )
}
