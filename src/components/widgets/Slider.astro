---
import type { HTMLAttributes } from 'astro/types';

export interface SliderConfig {
  /** Autoplay delay in ms, object with options, or false to disable */
  autoplay?: number | false | { delay: number; disableOnInteraction?: boolean };
  /** Loop slides */
  loop?: boolean;
  /** Number of slides visible at once (slidesPerView alias kept for compatibility) */
  columns?: number;
  /** Deprecated alias for columns */
  slidesPerView?: number;
  /** Gap between slides in px */
  gap?: number;
  /** Visible width (in px) of the next/prev slide peek on mobile (<640px) */
  peek?: number;
  /** Show pagination dots */
  pagination?: boolean;
  /** Show prev/next arrows */
  navigation?: boolean;
  /** Slide alignment inside the viewport (defaults to center for 1 column, start otherwise) */
  align?: 'start' | 'center' | 'end';
  /** Number of slides to scroll per navigation action (defaults to 1 for 1 column, 'auto' otherwise) */
  slidesToScroll?: number | 'auto';
}

interface Props extends Omit<HTMLAttributes<'div'>, 'id'> {
  config?: SliderConfig;
}

const { config = {}, class: className, ...attrs } = Astro.props;

const containerId = `slider-${crypto.randomUUID()}`;

const {
  autoplay = false,
  loop = false,
  columns: columnsProp,
  slidesPerView,
  gap: gapProp,
  peek: peekProp,
  pagination = false,
  navigation = false,
  align: alignProp,
  slidesToScroll: slidesToScrollProp,
} = config;

const columns = columnsProp ?? slidesPerView ?? 1;
const isMulti = columns > 1;
const gap = gapProp ?? 24;
const peek = peekProp ?? 80;
const align = alignProp ?? (isMulti ? 'start' : 'center');
const slidesToScroll = slidesToScrollProp ?? (isMulti ? 'auto' : 1);

const hasAutoplay = autoplay !== false;
const autoplayDelay = hasAutoplay
  ? typeof autoplay === 'object'
    ? autoplay.delay
    : typeof autoplay === 'number'
      ? autoplay
      : 5000
  : 5000;

const autoplayDisableOnInteraction =
  hasAutoplay && typeof autoplay === 'object' && autoplay.disableOnInteraction !== false;

const emblaConfig = {
  hasAutoplay,
  autoplayDelay,
  autoplayDisableOnInteraction,
  loop,
  align,
  slidesToScroll,
  hasPagination: pagination,
  hasNavigation: navigation,
};

const responsiveCss = `
  [data-embla-id="${containerId}"] { --spv: 1; --gap: ${gap}px; --peek: ${peek}px; }
  @media (min-width: 640px) {
    [data-embla-id="${containerId}"] { --spv: ${Math.min(columns, 2)}; --peek: 0px; }
  }
  @media (min-width: 1024px) {
    [data-embla-id="${containerId}"] { --spv: ${columns}; }
  }
`;
---

<div
  class:list={['relative md:px-14', className]}
  id={containerId}
  data-embla-id={containerId}
  data-embla-config={JSON.stringify(emblaConfig)}
  {...attrs}
>
  <div
    class="embla-viewport h-full relative overflow-visible md:overflow-hidden pb-8 md:[mask-image:linear-gradient(to_right,transparent_0%,black_5%,black_95%,transparent_100%)] md:[-webkit-mask-image:linear-gradient(to_right,transparent_0%,black_5%,black_95%,transparent_100%)]"
  >
    <div class="embla-track h-full" data-embla-track>
      <slot />
    </div>
  </div>

  {pagination && <div data-embla-dots class="flex justify-center gap-3 mt-3" />}

  {
    navigation && (
      <>
        <button
          data-embla-prev
          class="hidden md:flex absolute top-1/2 -translate-y-1/2 left-4 z-10 items-center justify-center w-10 h-10 rounded-full bg-white/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-200 shadow-md border-none cursor-pointer transition-colors hover:bg-white dark:hover:bg-slate-800"
          aria-label="Previous slide"
          type="button"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5">
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </button>
        <button
          data-embla-next
          class="hidden md:flex absolute top-1/2 -translate-y-1/2 right-4 z-10 items-center justify-center w-10 h-10 rounded-full bg-white/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-200 shadow-md border-none cursor-pointer transition-colors hover:bg-white dark:hover:bg-slate-800"
          aria-label="Next slide"
          type="button"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </button>
      </>
    )
  }

  <style is:inline set:html={responsiveCss}></style>
</div>

<script>
  import { registerEmblaSliders } from '~/utils/embla';

  registerEmblaSliders('[data-embla-config]', '.embla-viewport', 'embla-initialized', '[data-embla-dots]', {
    getConfig: (el) => JSON.parse(el.dataset.emblaConfig || '{}') as import('~/utils/embla').EmblaBaseConfig,
    getOptions: (config) => ({ loop: config.loop, align: config.align || 'start' }),
  });
</script>
