---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'div'>, 'id'> {
  config?: {
    /** Autoplay delay in ms, object with options, or false to disable */
    autoplay?: number | false | { delay: number; disableOnInteraction?: boolean };
    /** Loop slides */
    loop?: boolean;
    /** Transition effect */
    effect?: 'slide' | 'fade';
    /** Slide alignment inside the viewport */
    align?: 'start' | 'center' | 'end';
    /** Show adjacent slides peeking on mobile; hides arrows on mobile and masks edges on desktop */
    peek?: boolean;
    /** Slides visible at once */
    slidesPerView?: number;
    /** Gap between slides in px */
    gap?: number;
    /** Responsive breakpoints — keys are min-width in px */
    responsive?: Record<number, { slidesPerView?: number; gap?: number }>;
    /** Show pagination dots */
    pagination?: boolean;
    /** Show prev/next arrows */
    navigation?: boolean;
    /** Place navigation arrows outside the slide viewport */
    navOutside?: boolean;
    /** Navigation style */
    navStyle?: 'default' | 'minimal';
    /** Horizontal position of minimal navigation */
    minimalNavPosition?: 'left' | 'right';
  };
}

const { config = {}, class: className, ...attrs } = Astro.props;

const containerId = `slider-${crypto.randomUUID()}`;

const {
  autoplay = false,
  loop = false,
  effect = 'slide',
  align = 'start',
  peek = false,
  slidesPerView,
  gap = 0,
  responsive,
  pagination = false,
  navigation = false,
  navOutside = false,
  navStyle = 'default',
  minimalNavPosition = 'right',
} = config;

const hasAutoplay = autoplay !== false;
const autoplayDelay = hasAutoplay
  ? typeof autoplay === 'object'
    ? autoplay.delay
    : typeof autoplay === 'number'
      ? autoplay
      : 5000
  : 5000;

const autoplayDisableOnInteraction =
  hasAutoplay && typeof autoplay === 'object' && autoplay.disableOnInteraction !== false;

const emblaConfig = {
  hasAutoplay,
  autoplayDelay,
  autoplayDisableOnInteraction,
  loop,
  effect,
  align,
  peek,
  hasPagination: pagination !== false,
  hasNavigation: navigation !== false,
};

// Build CSS for track gap and slide width, including base + breakpoint overrides
const trackBaseRules: string[] = [];
if (gap !== undefined) {
  trackBaseRules.push(`gap: ${gap}px`);
  trackBaseRules.push(`--gap: ${gap}px`);
}

const baseTrackCss =
  trackBaseRules.length > 0
    ? `[data-embla-id="${containerId}"] [data-embla-track] { ${trackBaseRules.join('; ')} }`
    : '';

const responsiveTrackCss = responsive
  ? Object.entries(responsive)
      .sort(([a], [b]) => Number(a) - Number(b))
      .map(([bp, cfg]) => {
        const rules: string[] = [];
        if (cfg.gap !== undefined) {
          rules.push(`gap: ${cfg.gap}px`);
          rules.push(`--gap: ${cfg.gap}px`);
        }
        return rules.length > 0
          ? `@media (min-width: ${bp}px) { [data-embla-id="${containerId}"] [data-embla-track] { ${rules.join('; ')} } }`
          : '';
      })
      .filter(Boolean)
      .join('\n')
  : '';

const slideBaseRules: string[] = [];
if (slidesPerView !== undefined) slideBaseRules.push(`--spv: ${slidesPerView}`);

const baseSlideCss =
  slideBaseRules.length > 0 ? `[data-embla-id="${containerId}"] .embla-slide { ${slideBaseRules.join('; ')} }` : '';

const responsiveSlideCss = responsive
  ? Object.entries(responsive)
      .sort(([a], [b]) => Number(a) - Number(b))
      .map(([bp, cfg]) => {
        const rules: string[] = [];
        if (cfg.slidesPerView !== undefined) rules.push(`--spv: ${cfg.slidesPerView}`);
        return rules.length > 0
          ? `@media (min-width: ${bp}px) { [data-embla-id="${containerId}"] .embla-slide { ${rules.join('; ')} } }`
          : '';
      })
      .filter(Boolean)
      .join('\n')
  : '';

const slideCss = [baseTrackCss, responsiveTrackCss, baseSlideCss, responsiveSlideCss].filter(Boolean).join('\n');
---

<div
  class:list={['relative', navOutside && (peek ? 'md:px-12' : 'px-12'), className]}
  id={containerId}
  data-embla-id={containerId}
  data-embla-config={JSON.stringify(emblaConfig)}
  {...attrs}
>
  <div
    class:list={[
      'h-full relative',
      peek
        ? 'overflow-visible md:overflow-hidden md:[mask-image:linear-gradient(to_right,transparent_0%,black_5%,black_95%,transparent_100%)] md:[-webkit-mask-image:linear-gradient(to_right,transparent_0%,black_5%,black_95%,transparent_100%)]'
        : 'overflow-hidden',
    ]}
  >
    <div class:list={['flex h-full mb-8']} data-embla-track>
      <slot />
    </div>

    {
      pagination && !navOutside && navStyle !== 'minimal' && (
        <div data-embla-dots class="absolute bottom-4 left-1/2 -translate-x-1/2 flex justify-center gap-2 z-10" />
      )
    }
  </div>

  {pagination && navOutside && navStyle !== 'minimal' && <div data-embla-dots class="flex justify-center gap-2 mt-3" />}

  {
    navigation && !navOutside && navStyle !== 'minimal' && (
      <>
        <button
          data-embla-prev
          class:list={[
            'absolute top-1/2 -translate-y-1/2 left-2 z-10 flex items-center justify-center w-10 h-10 rounded-full bg-white/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-200 shadow-md border-none cursor-pointer transition-colors hover:bg-white dark:hover:bg-slate-800',
            peek && 'hidden md:flex',
          ]}
          aria-label="Previous slide"
          type="button"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5">
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </button>
        <button
          data-embla-next
          class:list={[
            'absolute top-1/2 -translate-y-1/2 right-2 z-10 flex items-center justify-center w-10 h-10 rounded-full bg-white/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-200 shadow-md border-none cursor-pointer transition-colors hover:bg-white dark:hover:bg-slate-800',
            peek && 'hidden md:flex',
          ]}
          aria-label="Next slide"
          type="button"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </button>
      </>
    )
  }

  {
    navigation && navOutside && navStyle !== 'minimal' && (
      <>
        <button
          data-embla-prev
          class:list={[
            'absolute top-1/2 -translate-y-1/2 left-0 z-10 flex items-center justify-center w-10 h-10 rounded-full bg-white/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-200 shadow-md border-none cursor-pointer transition-colors hover:bg-white dark:hover:bg-slate-800',
            peek && 'hidden md:flex',
          ]}
          aria-label="Previous slide"
          type="button"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5">
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </button>
        <button
          data-embla-next
          class:list={[
            'absolute top-1/2 -translate-y-1/2 right-0 z-10 flex items-center justify-center w-10 h-10 rounded-full bg-white/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-200 shadow-md border-none cursor-pointer transition-colors hover:bg-white dark:hover:bg-slate-800',
            peek && 'hidden md:flex',
          ]}
          aria-label="Next slide"
          type="button"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </button>
      </>
    )
  }

  {
    navigation && navStyle === 'minimal' && (
      <div
        class:list={[
          'absolute bottom-4 z-10 flex items-center gap-2',
          minimalNavPosition === 'left' ? 'left-4' : 'right-4',
        ]}
      >
        {hasAutoplay && (
          <button
            data-embla-pause
            class="flex items-center justify-center w-9 h-9 rounded-full bg-white/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-200 shadow-md border-none cursor-pointer transition-colors hover:bg-white dark:hover:bg-slate-800"
            aria-label="Pause slideshow"
            type="button"
          >
            <svg class="embla-pause-icon w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <rect x="6" y="4" width="4" height="16" rx="1" />
              <rect x="14" y="4" width="4" height="16" rx="1" />
            </svg>
            <svg class="embla-play-icon w-5 h-5 hidden" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z" />
            </svg>
          </button>
        )}
        <button
          data-embla-prev
          class="flex items-center justify-center w-9 h-9 rounded-full bg-white/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-200 shadow-md border-none cursor-pointer transition-colors hover:bg-white dark:hover:bg-slate-800"
          aria-label="Previous slide"
          type="button"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5">
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </button>
        <button
          data-embla-next
          class="flex items-center justify-center w-9 h-9 rounded-full bg-white/80 dark:bg-slate-800/80 text-slate-700 dark:text-slate-200 shadow-md border-none cursor-pointer transition-colors hover:bg-white dark:hover:bg-slate-800"
          aria-label="Next slide"
          type="button"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5">
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </button>
      </div>
    )
  }

  {slideCss && <style is:inline set:html={slideCss} />}
</div>

<script>
  import EmblaCarousel from 'embla-carousel';
  import Autoplay from 'embla-carousel-autoplay';
  import Fade from 'embla-carousel-fade';
  import type { EmblaCarouselType, EmblaPluginType } from 'embla-carousel';
  import type { AutoplayType } from 'embla-carousel-autoplay';

  const ACTIVE_ATTR = 'data-active';

  function buildPagination(emblaApi: EmblaCarouselType, rootEl: HTMLElement): void {
    const dotsContainer = rootEl.querySelector<HTMLElement>('[data-embla-dots]');
    if (!dotsContainer) return;

    const slides = emblaApi.scrollSnapList();
    dotsContainer.innerHTML = '';

    for (let i = 0; i < slides.length; i++) {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.className =
        'w-3 h-3 rounded-full bg-slate-400 dark:bg-white/30 border-none cursor-pointer p-0 transition-colors data-[active]:bg-slate-700 dark:data-[active]:bg-white/90';
      dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
      dot.addEventListener('click', () => emblaApi.scrollTo(i));
      dotsContainer.appendChild(dot);
    }

    const dots = dotsContainer.querySelectorAll('button');

    const updateDots = (): void => {
      const selected = emblaApi.selectedScrollSnap();
      dots.forEach((dot, i) => {
        if (i === selected) {
          dot.setAttribute(ACTIVE_ATTR, '');
        } else {
          dot.removeAttribute(ACTIVE_ATTR);
        }
      });
    };

    emblaApi.on('select', updateDots);
    emblaApi.on('reInit', updateDots);
    updateDots();
  }

  function setupPauseOnInteraction(
    autoplayPlugin: AutoplayType,
    rootEl: HTMLElement,
    isUserPaused: () => boolean
  ): void {
    let resumeTimer: ReturnType<typeof setTimeout> | null = null;

    const scheduleResume = (): void => {
      if (resumeTimer) clearTimeout(resumeTimer);
      resumeTimer = setTimeout(() => {
        if (!autoplayPlugin.isPlaying() && !isUserPaused()) {
          autoplayPlugin.play();
        }
      }, 3000);
    };

    const stopAndClear = (): void => {
      autoplayPlugin.stop();
      if (resumeTimer) clearTimeout(resumeTimer);
    };

    rootEl.addEventListener('pointerdown', stopAndClear);
    rootEl.addEventListener('touchstart', stopAndClear, { passive: true });
    rootEl.addEventListener('pointerup', scheduleResume);
    rootEl.addEventListener('mouseleave', scheduleResume);
  }

  function initEmblaCarousels(): void {
    document.querySelectorAll<HTMLElement>('[data-embla-config]:not(.embla-initialized)').forEach((el) => {
      const config = JSON.parse(el.dataset.emblaConfig || '{}');
      const viewport = el.querySelector<HTMLElement>('[class*="overflow-hidden"]');
      if (!viewport || !config) return;

      const plugins: EmblaPluginType[] = [];
      let autoplayPlugin: AutoplayType | null = null;

      if (config.hasAutoplay) {
        autoplayPlugin = Autoplay({
          delay: config.autoplayDelay,
          stopOnLastSnap: !config.loop,
          stopOnInteraction: false,
          playOnInit: false,
        });
        plugins.push(autoplayPlugin);
      }

      if (config.effect === 'fade') {
        plugins.push(Fade());
      }

      const emblaApi = EmblaCarousel(
        viewport,
        {
          loop: config.loop,
          align: config.align || 'start',
          slidesToScroll: 1,
          direction: document.documentElement.dir === 'rtl' ? 'rtl' : 'ltr',
        },
        plugins
      );

      // Start autoplay (only if more than 1 slide)
      let userPaused = false;
      if (autoplayPlugin && emblaApi.slideNodes().length > 1) {
        autoplayPlugin.play();
      }

      // Pause-on-interaction with auto-resume after 3s
      if (autoplayPlugin && config.autoplayDisableOnInteraction && emblaApi.slideNodes().length > 1) {
        setupPauseOnInteraction(autoplayPlugin, el, () => userPaused);
      }

      // Pause button
      const pauseBtn = el.querySelector<HTMLElement>('[data-embla-pause]');
      if (autoplayPlugin && pauseBtn) {
        const updatePauseIcon = (playing: boolean): void => {
          pauseBtn.querySelector<HTMLElement>('.embla-pause-icon')?.classList.toggle('hidden', !playing);
          pauseBtn.querySelector<HTMLElement>('.embla-play-icon')?.classList.toggle('hidden', playing);
          pauseBtn.setAttribute('aria-label', playing ? 'Pause slideshow' : 'Play slideshow');
        };

        pauseBtn.addEventListener('click', () => {
          if (autoplayPlugin.isPlaying() && !userPaused) {
            autoplayPlugin.stop();
            userPaused = true;
          } else {
            autoplayPlugin.play();
            userPaused = false;
          }
          updatePauseIcon(!userPaused);
        });
      }

      // Navigation buttons
      const prevBtn = el.querySelector<HTMLElement>('[data-embla-prev]');
      const nextBtn = el.querySelector<HTMLElement>('[data-embla-next]');
      if (prevBtn) prevBtn.addEventListener('click', () => emblaApi.scrollPrev());
      if (nextBtn) nextBtn.addEventListener('click', () => emblaApi.scrollNext());

      // Pagination dots
      if (config.hasPagination) {
        buildPagination(emblaApi, el);
      }

      el.classList.add('embla-initialized');
    });
  }

  initEmblaCarousels();

  // Re-init after Astro view transitions
  document.addEventListener('astro:page-load', initEmblaCarousels);
</script>
