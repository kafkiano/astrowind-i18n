---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Slider from '~/components/widgets/Slider.astro';
import { Icon } from 'astro-icon/components';
import type { Features as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  items = [],
  columns = 3,
  defaultIcon,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-6xl ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} classes={classes?.headline as Record<string, string>} />

  {
    items.length > 0 && (
      <Slider
        config={{
          slidesPerView: 1,
          spaceBetween: 24,
          loop: true,
          pagination: false,
          navigation: false,
          responsive: {
            640: {
              slidesPerView: Math.min(columns, 2),
              spaceBetween: 16,
            },
            1024: {
              slidesPerView: columns,
              spaceBetween: 24,
            },
          },
        }}
      >
        {items.map(({ title: itemTitle, description, icon }) => (
          <div class="swiper-slide">
            <div class="mx-4 flex flex-row max-w-md p-4 md:p-6 rounded-xl dark:border dark:border-slate-600 shadow-xl dark:shadow-none">
              {(icon || defaultIcon) && (
                <div class="flex justify-center">
                  <Icon
                    name={icon || defaultIcon}
                    class="text-white bg-primary rounded-full w-10 h-10 p-2 md:w-12 md:h-12 md:p-3 mr-4 rtl:ml-4 rtl:mr-0"
                  />
                </div>
              )}
              <div>
                {itemTitle && <h3 class="text-xl font-bold">{itemTitle}</h3>}
                {description && <p class="mt-3 text-muted" set:html={description} />}
              </div>
            </div>
          </div>
        ))}
      </Slider>
    )
  }
</WidgetWrapper>
