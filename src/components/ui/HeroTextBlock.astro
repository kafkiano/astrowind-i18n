---
import Button from '~/components/ui/Button.astro';
import type { CallToAction } from '~/types';

interface Props {
  title?: string;
  subtitle?: string;
  tagline?: string;
  actions?: string | (string | CallToAction)[];
  align?: 'center' | 'left';
  /** Enable intersection-observer fade animation on text elements */
  animate?: boolean;
}

const { title, subtitle, tagline, actions, align = 'center', animate = true } = Astro.props;

const animationClasses = animate
  ? 'intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
  : '';
---

{
  tagline && (
    <p
      class={`text-sm md:text-base text-secondary dark:text-secondary-200 font-bold tracking-wide uppercase ${animationClasses}`}
      set:html={tagline}
    />
  )
}
{
  title && (
    <h1
      class={`text-4xl md:text-5xl lg:text-6xl font-bold leading-tight tracking-tighter mb-4 font-heading dark:text-neutral-200 ${animationClasses}`}
      set:html={title}
    />
  )
}
<div class={align === 'left' ? 'max-w-3xl mx-auto lg:max-w-none' : 'max-w-3xl mx-auto'}>
  {
    subtitle && (
      <p class={`text-lg md:text-xl text-muted mb-6 dark:text-neutral-300 ${animationClasses}`} set:html={subtitle} />
    )
  }
  {
    actions && (
      <div
        class={
          align === 'left'
            ? `max-w-3xl mx-auto lg:max-w-none flex flex-nowrap flex-row justify-center lg:justify-start gap-4 ${animationClasses}`
            : `max-w-xs sm:max-w-md m-auto flex flex-nowrap flex-row justify-center gap-4 ${animationClasses}`
        }
      >
        {Array.isArray(actions) ? (
          actions.map((action) => (
            <div class="flex w-full sm:w-auto">
              {typeof action === 'string' ? (
                <Fragment set:html={action} />
              ) : (
                <Button {...(action || {})} class="w-full sm:mb-0" />
              )}
            </div>
          ))
        ) : (
          <Fragment set:html={actions} />
        )}
      </div>
    )
  }
</div>
