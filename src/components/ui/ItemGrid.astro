---
import type { ItemGrid as BaseProps } from '~/types';
import { twMerge } from 'tailwind-merge';
import FeatureCard from './FeatureCard.astro';

interface Props extends BaseProps {
  layout?: 'horizontal' | 'vertical';
}

const { items = [], columns, layout = 'horizontal', defaultIcon = '', classes = {} } = Astro.props;

const {
  container: containerClass = '',
  panel: panelClass = '',
  title: titleClass = '',
  description: descriptionClass = '',
  icon: defaultIconClass = layout === 'vertical'
    ? 'text-primary mb-2 w-10 h-10'
    : 'text-primary w-7 h-7 mr-2 rtl:mr-0 rtl:ml-2',
  action: actionClass = '',
} = classes;

const gridGapClasses = layout === 'vertical' ? 'gap-8 gap-x-12 sm:gap-y-8' : 'gap-8 md:gap-y-12';

const gridAlignClasses = layout === 'vertical' ? 'grid' : 'grid mx-auto';

const intersectClasses =
  layout === 'vertical'
    ? 'intersect-once intersect-quarter intersect-no-queue motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade'
    : 'intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade';
---

{
  items && items.length > 0 && (
    <div
      class={twMerge(
        `${gridAlignClasses} ${gridGapClasses} ${
          columns === 4
            ? 'lg:grid-cols-4 md:grid-cols-3 sm:grid-cols-2'
            : columns === 3
              ? 'lg:grid-cols-3 sm:grid-cols-2'
              : columns === 2
                ? 'sm:grid-cols-2 '
                : ''
        }`,
        containerClass
      )}
    >
      {items.map(({ title, description, icon, callToAction, classes: itemClasses = {} }) => (
        <div class={twMerge(intersectClasses, layout === 'vertical' ? 'relative' : '')}>
          <FeatureCard
            layout={layout}
            title={title}
            description={description}
            icon={icon}
            defaultIcon={defaultIcon}
            callToAction={callToAction}
            classes={{
              panel: twMerge(panelClass, itemClasses?.panel),
              title: twMerge(titleClass, itemClasses?.title),
              description: twMerge(descriptionClass, itemClasses?.description),
              icon: twMerge(defaultIconClass, itemClasses?.icon),
              action: twMerge(actionClass, itemClasses?.actionClass),
            }}
          />
        </div>
      ))}
    </div>
  )
}
