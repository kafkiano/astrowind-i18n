---
import { I18N } from 'astrowind:config';
import Layout from '~/layouts/Layout.astro';

const supportedLocales = I18N.locales;
const defaultLocale = I18N.defaultLocale;
---

<Layout>
  <script is:inline define:vars={{ supportedLocales, defaultLocale }}>
    // Detect browser language preference
    const preferred = navigator.languages.find((lang) => {
      const base = lang.split('-')[0];
      return supportedLocales.includes(base) || supportedLocales.includes(lang);
    });

    const currentLocale = preferred ? preferred.split('-')[0] : defaultLocale;

    // Check if we're already on a locale-prefixed path
    const localeRegex = new RegExp(`^/(${supportedLocales.join('|')})(/|$)`);
    if (!localeRegex.test(window.location.pathname)) {
      // Create meta refresh with detected locale
      const meta = document.createElement('meta');
      meta.httpEquiv = 'refresh';
      meta.content = `0;url=/${currentLocale}`;
      document.head.appendChild(meta);
    }
  </script>
</Layout>
