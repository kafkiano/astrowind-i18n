---
/* eslint-disable @typescript-eslint/no-explicit-any */
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getTemplateEntry } from '~/utils/templates';

import { getStaticPathsForLocale } from '~/utils/i18n';
export const getStaticPaths = getStaticPathsForLocale;

export const navigation = {
  title: 'FAQ',
  showIn: 'header',
  order: 3,
};

const locale = Astro.currentLocale ?? 'en';
const page = await getTemplateEntry('faq', locale);
const { data } = page;

const hero = data.hero as any;
const items = data.items as any;
const cta = data.cta as any;

const metadata = {
  title: data.title,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <Hero variant="text-only" tagline={hero?.tagline} title={hero?.title} />

  <!-- FAQ accordion -->
  <FAQs columns={1} classes={{ container: 'max-w-4xl' }} items={items} />

  <!-- CTA -->
  <CallToAction title={cta?.title} subtitle={cta?.subtitle} actions={cta?.actions} />
</Layout>
