---
/* eslint-disable @typescript-eslint/no-explicit-any */
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getTemplateEntry } from '~/utils/templates';

import { getStaticPathsForLocale } from '~/utils/i18n';
export const getStaticPaths = getStaticPathsForLocale;

export const navigation = {
  title: 'Services',
  showIn: 'header',
  order: 1,
};

const locale = Astro.currentLocale ?? 'en';
const page = await getTemplateEntry('services', locale);
const { data } = page;

const hero = data.hero as any;
const sections = data.sections as any;
const cta = data.cta as any;

const metadata = {
  title: data.title,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <Hero
    variant="text-only"
    tagline={hero?.tagline}
    title={hero?.title}
    subtitle={hero?.subtitle}
  />

  {sections?.map((section: any, index: number) => (
    <Content
      isReversed={index % 2 !== 0}
      title={section.title}
      subtitle={section.subtitle}
      items={section.items}
      image={section.image}
    >
      {section.slotContent && (
        <div slot="content">
          {section.slotContent.heading && (
            <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
              {section.slotContent.heading}
            </h3>
          )}
          {section.slotContent.deliverables && (
            <ul class="list-disc list-inside space-y-1 text-muted dark:text-slate-400">
              {section.slotContent.deliverables.map((item: string) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
          {section.slotContent.note && (
            <p class="mt-6 text-sm text-muted dark:text-slate-500">
              {section.slotContent.note}
            </p>
          )}
          {section.slotContent.disclaimer && (
            <div class:list={[
              "p-4 rounded-lg border",
              section.slotContent.heading ? "mt-6" : "",
              "border-amber-200 dark:border-amber-800 bg-amber-50 dark:bg-amber-950/30"
            ]}>
              <p class="text-sm font-semibold text-amber-800 dark:text-amber-300 mb-1">
                {section.slotContent.disclaimer.title}
              </p>
              <p class="text-sm text-amber-700 dark:text-amber-400">
                {section.slotContent.disclaimer.text}
              </p>
            </div>
          )}
        </div>
      )}
    </Content>
  ))}

  <!-- CTA -->
  <CallToAction
    title={cta?.title}
    subtitle={cta?.subtitle}
    actions={cta?.actions}
  />
</Layout>
