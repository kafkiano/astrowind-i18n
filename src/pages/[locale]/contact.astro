---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features from '~/components/widgets/Features.astro';

import { getStaticPathsForLocale } from '~/utils/i18n';
export const getStaticPaths = getStaticPathsForLocale;

export const navigation = {
  title: 'Contact',
  group: 'Company',
};

const metadata = {
  title: 'Contact — Best Visual',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <Hero
    variant="text-only"
    tagline="Contact"
    title="Tell us what you are trying to achieve"
    subtitle="Property, marketing and design, business consulting, project delivery, or business setup. We will reply with the next step within 24 business hours."
  />

  <!-- Contact Form -->
  <ContactUs
    id="form"
    title="Send us a message"
    subtitle="Fill out the form below and we will get back to you with next steps or a call scheduling link."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
        autocomplete: 'name',
        placeholder: 'Your full name',
      },
      {
        type: 'text',
        name: 'company',
        label: 'Company',
        autocomplete: 'organization',
        placeholder: 'Your company name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
        autocomplete: 'email',
        placeholder: 'you@company.com',
      },
      {
        type: 'tel',
        name: 'phone',
        label: 'Phone',
        autocomplete: 'tel',
        placeholder: '+971 50 123 4567',
      },
      {
        type: 'select',
        name: 'service',
        label: 'Service',
        placeholder: 'Select a service',
      },
    ]}
    textarea={{
      label: 'Message',
      name: 'message',
      placeholder: 'Tell us about your project, goals, and what you need help with...',
      rows: 5,
    }}
    disclaimer={{
      label:
        'By submitting this contact form, you acknowledge and agree to the collection of your personal information as described in our Privacy Policy.',
    }}
    description="We typically respond within 24 business hours with next steps or a call scheduling link."
  />

  <!-- Contact info cards -->
  <Features
    variant="cards-vertical"
    title="Other ways to reach us"
    columns={3}
    items={[
      {
        title: 'Email',
        description: 'info@bestvisual.ae',
        icon: 'tabler:mail',
      },
      {
        title: 'Phone',
        description: '+971 4 254 4910',
        icon: 'tabler:phone',
      },
      {
        title: 'Location',
        description: 'Ras Al Khaimah Economic Zone (RAKEZ), UAE',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>
