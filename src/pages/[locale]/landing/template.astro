---
import { getStaticPathsForLocale } from '~/utils/i18n';
import { getTemplateEntry } from '~/utils/templates';
import Layout from '~/layouts/LandingLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import type { Item, Testimonial, CallToAction as CallToActionType } from '~/types';

export const getStaticPaths = getStaticPathsForLocale;

export const navigation = {
  title: 'Template Demo',
  group: 'Demos',
  showIn: 'all',
};

interface HeroSection {
  tagline?: string;
  title?: string;
  subtitle?: string;
  image?: string | unknown;
  actions?: string | CallToActionType[];
}

interface FeaturesSection {
  tagline?: string;
  title?: string;
  items?: Item[];
}

interface CTASection {
  title?: string;
  subtitle?: string;
  actions?: string | CallToActionType[];
}

const locale = Astro.currentLocale ?? 'en';
const page = await getTemplateEntry('landing', locale);
const { data } = page;

// Cast passthrough fields — schema only requires title, rest is free-form
const hero = data.hero as HeroSection | undefined;
const features = data.features as FeaturesSection | undefined;
const testimonials = data.testimonials as Testimonial[] | undefined;
const cta = data.cta as CTASection | undefined;
---

<Layout metadata={navigation}>
  {
    hero && (
      <Hero
        tagline={hero.tagline}
        title={hero.title}
        subtitle={hero.subtitle}
        image={hero.image}
        actions={hero.actions}
      />
    )
  }

  {features && <Features tagline={features.tagline} title={features.title} items={features.items} />}

  {testimonials && <Testimonials variant="slider" testimonials={testimonials} />}

  {cta && <CallToAction title={cta.title} subtitle={cta.subtitle} actions={cta.actions} />}
</Layout>
