---
import Layout from '~/layouts/Layout.astro';
import { getStaticPathsForLocale } from '~/utils/i18n';

export const getStaticPaths = getStaticPathsForLocale;
export const navigation = {
  // @wc-ignore
  title: 'Landing',
  type: 'group',
  order: 2,
};

const metadata = {
  title: navigation.title, // navigation title, can be replaced with a more meaningful static title
};
const currentLocale = Astro.currentLocale;
---

<Layout metadata={metadata}>
  <head>
    <meta http-equiv="refresh" content={`0;url=/${currentLocale}`} />
  </head>
</Layout>
