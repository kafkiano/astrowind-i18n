  <!-- Badge Banner (NEW) ************ -->

  <Badge variant="banner" text="Now with Team, Gallery & Badge widgets!" href="#team" />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Get template',
        href: 'https://github.com/kafkiano/astrowind-i18n',
        target: '_blank',
        icon: 'tabler:download',
      },
    ]}
  >
    <div slot="title">
      Astro&nbsp;+&nbsp;<br class="block sm:hidden" /><span class="sm:whitespace-nowrap">Tailwind CSS</span>
    </div>

    <span slot="subtitle">
      Be very surprised by these huge fake numbers you are seeing on this page. <br class="hidden md:inline" />Don't
      waste more time! :P
    </span>
  </CallToAction>
</Layout>
