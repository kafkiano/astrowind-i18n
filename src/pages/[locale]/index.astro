---
/* eslint-disable @typescript-eslint/no-explicit-any */
import { getEntry, render } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Team from '~/components/widgets/Team.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Badge from '~/components/widgets/Badge.astro';
import Gallery from '~/components/widgets/Gallery.astro';

import { getStaticPathsForLocale } from '~/utils/i18n';
export const getStaticPaths = getStaticPathsForLocale;

const locale = Astro.currentLocale ?? 'en';
let home = await getEntry('templates', `${locale}/home`);
// Fall back to source locale if translation doesn't exist yet
if (!home) {
  home = await getEntry('templates', `en/home`);
}
if (!home) {
  throw new Error(`Home page not found for locale: ${locale} (or fallback en)`);
}

const { Content: BodyContent } = await render(home);
const { data } = home;

// Extract sections from frontmatter (passthrough schema — fields are untyped)
const hero = data.hero as any;
const welcome = data.welcome as any;
const kitchenHeading = data.kitchenHeading as any;
const dishes = data.dishes as any;
const cocktails = data.cocktails as any;
const exhibitions = data.exhibitions as any;
const testimonials = data.testimonials as any;
const rawTeam = data.team as any[] | undefined;
const cta = data.cta as any;

const team = rawTeam?.map((member: any) => ({
  ...member,
  image: member.image ? { src: member.image, alt: member.imageAlt || member.name || 'Team member' } : undefined,
}));

const metadata = {
  title: data.title,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero **************************** -->

  <Hero variant="centered" title={hero?.title} subtitle={hero?.subtitle} tagline={hero?.tagline} />

  <!-- TripAdvisor certificates ******** -->

  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 md:py-12 text-center">
    <div class="flex flex-wrap gap-6 justify-center items-center">
      <Badge variant="inline" text="Certificate of Excellence 2019" />
      <Badge variant="inline" text="Certificate of Excellence 2018" />
      <Badge variant="inline" text="Certificate of Excellence 2017" />
    </div>
    <p class="mt-4 text-muted text-sm">Recommended on Tripadvisor</p>
  </div>

  <!-- Welcome ************************* -->

  <div class="relative">
    <Content
      tagline={welcome?.tagline}
      title={welcome?.title}
      items={welcome?.items}
      image={welcome?.image ? { src: welcome.image, alt: 'Fresh food at Artesano' } : undefined}
    >
      <div slot="content">
        <div class="text-lg text-muted dark:text-slate-400">
          <BodyContent />
        </div>
      </div>
    </Content>
  </div>

  <!-- Kitchen & bar heading *********** -->

  {
    kitchenHeading && (
      <div class="max-w-7xl mx-auto px-4 sm:px-6 py-12 md:py-16 text-center">
        {kitchenHeading.tagline && (
          <p class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase">
            {kitchenHeading.tagline}
          </p>
        )}
        {kitchenHeading.title && (
          <h2 class="text-3xl md:text-4xl font-bold leading-tight tracking-tighter font-heading text-heading dark:text-white">
            {kitchenHeading.title}
          </h2>
        )}
      </div>
    )
  }

  {
    kitchenHeading?.images && (
      <Gallery
        images={kitchenHeading.images}
        columns={4}
        variant="grid"
        mobileVariant="peek"
        pagination={false}
      />
    )
  }

  <!-- Dishes ************************** -->

  {
    dishes && (
      <Content
        tagline={dishes.tagline}
        title={dishes.title}
        items={dishes.items}
        image={dishes.image ? { src: dishes.image, alt: dishes.tagline || 'Dishes at Artesano' } : undefined}
      />
    )
  }

  <!-- Cocktail Bar ******************** -->

  {
    cocktails && (
      <Content
        isReversed
        tagline={cocktails.tagline}
        title={cocktails.title}
        items={cocktails.items}
        image={
          cocktails.image ? { src: cocktails.image, alt: cocktails.tagline || 'Cocktails at Artesano' } : undefined
        }
      />
    )
  }

  <!-- Exhibitions ********************* -->

  {
    exhibitions && (
      <Content
        tagline={exhibitions.tagline}
        title={exhibitions.title}
        items={exhibitions.items}
        image={
          exhibitions.image ? { src: exhibitions.image, alt: exhibitions.tagline || 'Art at Artesano' } : undefined
        }
      />
    )
  }

  <!-- Testimonials slider ************ -->

  {
    testimonials && (
      <Testimonials
        tagline="Testimonials" 
        title="What our guests say"
        subtitle="From our TripAdvisor reviews…"
        testimonials={testimonials}
        variant="slider"
        columns={2}
        autoplay={{ delay: 6000, disableOnInteraction: true }}
        navigation
        pagination
        loop
      />
    )
  }

  <!-- Team **************************** -->

  {team && <Team tagline="The Artesano Team" title="Always at your service" team={team} />}

  <!-- Call to Action ****************** -->

  {cta && <CallToAction title={cta.title} subtitle={cta.subtitle} actions={cta.actions} />}
</Layout>
