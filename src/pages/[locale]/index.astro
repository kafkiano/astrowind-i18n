---
/* eslint-disable @typescript-eslint/no-explicit-any */
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import HeroSlider from '~/components/widgets/HeroSlider.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import { getTemplateEntry } from '~/utils/templates';

import { getStaticPathsForLocale } from '~/utils/i18n';
export const getStaticPaths = getStaticPathsForLocale;

const locale = Astro.currentLocale ?? 'en';
const home = await getTemplateEntry('home', locale);
const { data } = home;

const hero = data.hero as any;
const heroSlider = data.heroSlider as any;
const servicesIntro = data.servicesIntro as any;
const services = data.services as any;
const howWeWork = data.howWeWork as any;
const cta = data.cta as any;

const metadata = {
  title: data.title,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero -->
  {
    heroSlider?.slides?.length ? (
      <HeroSlider
        autoplay={{ delay: 5000, disableOnInteraction: true }}
        slides={heroSlider.slides}
      />
    ) : (
      <Hero
        variant="centered"
        title={hero?.title}
        subtitle={hero?.subtitle}
        tagline={hero?.tagline}
        content={hero?.content}
        actions={hero?.actions}
      />
    )
  }

  <!-- Services Intro + Slider -->
  <Features
    variant="slider"
    autoplay={{ delay: 4000, disableOnInteraction: false }}
    pagination={true}
    navigation={true}
    loop={true}
    columns={3}
    tagline={servicesIntro?.tagline}
    title={servicesIntro?.title}
    subtitle={servicesIntro?.subtitle}
    items={services?.items}
  />

  <!-- How We Work -->
  <Steps tagline={howWeWork?.tagline} title={howWeWork?.title} items={howWeWork?.items} />

  <!-- Latest Insights -->
  <BlogLatestPosts
    title="Latest insights"
    information="Practical articles for buyers, investors, and operators — covering UAE business setup, cross-border real estate, project management, and more."
    linkText="View all insights"
    linkUrl="/insights"
    count={4}
    classes={{ container: 'max-w-6xl' }}
  />

  <!-- Call to Action -->
  <CallToAction title={cta?.title} subtitle={cta?.subtitle} actions={cta?.actions} />
</Layout>
