---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import { getStaticPathsForLocale } from '~/utils/i18n';
export const getStaticPaths = getStaticPathsForLocale;

export const navigation = {
  title: 'About',
  showIn: 'footer',
  group: 'Company',
};

const metadata = {
  title: 'About Best Visual | RAKEZ Licensed Company',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero -->
  <Hero
    variant="text-only"
    tagline="About us"
    title="About Best Visual"
    subtitle="A RAKEZ-licensed company in Ras Al Khaimah, UAE, supporting clients across the UAE, Germany, and Spain."
  />

  <!-- Company description -->
  <Content
    title="Execution-focused services across borders"
    items={[
      {
        title: 'Cross-border experience',
        description:
          'We understand the practical requirements of operating across UAE, German, and Spanish markets — regulatory nuances, cultural expectations, and local business practices.',
        icon: 'tabler:world',
      },
      {
        title: 'Execution focus',
        description:
          'Every engagement includes deliverables, timelines, and weekly progress reporting. We do not work on retainer without defined outputs.',
        icon: 'tabler:target-arrow',
      },
      {
        title: 'Integrated service',
        description:
          'From strategy and consulting to creative execution and operational management — a single point of coordination for complex, multi-workstream projects.',
        icon: 'tabler:puzzle',
      },
      {
        title: 'Transparent operations',
        description:
          'You always know what is happening, what is next, and where things stand. Weekly reports, clear milestones, and no surprises.',
        icon: 'tabler:eye',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1497366216548-37526070297c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1169&q=80',
      alt: 'Modern office space',
    }}
  >
    <div slot="content">
      <p class="text-lg text-muted dark:text-slate-400">
        Best Visual is a RAKEZ-licensed company in Ras Al Khaimah, UAE. We deliver execution-focused services in real
        estate, marketing, content creation, corporate design, business consulting, project delivery, and business setup
        coordination.
      </p>
      <p class="mt-4 text-lg text-muted dark:text-slate-400">
        We do not work on retainer without deliverables. Every project starts with a clear scope, realistic timeline,
        and defined outputs. Progress is tracked weekly, reported transparently, and adjusted based on results.
      </p>
    </div>
  </Content>

  <!-- Core service areas -->
  <Features
    variant="cards-vertical"
    tagline="Core services"
    title="What we do"
    columns={3}
    items={[
      {
        title: 'Real Estate Consultancy & Brokerage',
        description:
          'Advisory, sourcing, brokerage support, and transaction coordination for buyers, sellers, and investors.',
        icon: 'tabler:building-estate',
      },
      {
        title: 'Marketing & Content Creation',
        description:
          'Social media, content production, copywriting, SEO, and lead generation — strategy through to execution.',
        icon: 'tabler:ad',
      },
      {
        title: 'Corporate Design',
        description: 'Visual identity, logos, brand materials, presentations, and complete brand guidelines.',
        icon: 'tabler:paint',
      },
      {
        title: 'Project Management',
        description: 'Scope, planning, stakeholder coordination, risk tracking, and weekly executive reporting.',
        icon: 'tabler:chart-arrows',
      },
      {
        title: 'Business Setup & Consulting',
        description:
          'UAE company formation, market entry strategy, operational planning, and business plan development.',
        icon: 'tabler:briefcase',
      },
      {
        title: 'Financing Coordination',
        description: 'Mortgage and financing option coordination with banks and licensed partners.',
        icon: 'tabler:building-bank',
      },
    ]}
  />

  <!-- Who we serve -->
  <Content
    isReversed
    title="Who we serve"
    items={[
      {
        title: 'Property buyers & investors',
        description:
          'Clients seeking properties in UAE, Germany, or Spain — from first-time buyers to experienced investors building cross-border portfolios.',
        icon: 'tabler:home',
      },
      {
        title: 'Entrepreneurs & business owners',
        description:
          'Companies and individuals expanding operations to the UAE, navigating Free Zone, Mainland, and Offshore setup options.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Companies needing brand & digital presence',
        description:
          'Organizations requiring corporate identity, content strategy, and digital positioning across international markets.',
        icon: 'tabler:ad',
      },
      {
        title: 'Organizations needing project coordination',
        description:
          'Businesses requiring structured project delivery and coordination across borders, teams, and vendors.',
        icon: 'tabler:chart-arrows',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1529156069898-49953e39b3ac?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1332&q=80',
      alt: 'Business meeting',
    }}
  />

  <!-- Stats -->
  <Stats
    tagline="By the numbers"
    title="Our reach"
    stats={[
      { title: 'Countries', amount: '3', icon: 'tabler:world' },
      { title: 'Service areas', amount: '6', icon: 'tabler:category' },
      { title: 'Years in operation', amount: '5+', icon: 'tabler:calendar' },
      { title: 'Client projects', amount: '120+', icon: 'tabler:briefcase' },
    ]}
  />

  <!-- Company details -->
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-12 md:py-16">
    <div class="p-6 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-slate-900 shadow">
      <h2 class="text-xl font-bold text-heading dark:text-white mb-4">Company details</h2>
      <dl class="space-y-3 text-sm">
        <div class="flex flex-col sm:flex-row sm:gap-2">
          <dt class="font-semibold text-heading dark:text-white sm:w-40 shrink-0">Company:</dt>
          <dd class="text-muted dark:text-slate-400">Best Visual FZE</dd>
        </div>
        <div class="flex flex-col sm:flex-row sm:gap-2">
          <dt class="font-semibold text-heading dark:text-white sm:w-40 shrink-0">Registered in:</dt>
          <dd class="text-muted dark:text-slate-400">Ras Al Khaimah Economic Zone (RAKEZ), UAE</dd>
        </div>
        <div class="flex flex-col sm:flex-row sm:gap-2">
          <dt class="font-semibold text-heading dark:text-white sm:w-40 shrink-0">License Number:</dt>
          <dd class="text-muted dark:text-slate-400">[INSERT RAKEZ LICENSE NUMBER]</dd>
        </div>
        <div class="flex flex-col sm:flex-row sm:gap-2">
          <dt class="font-semibold text-heading dark:text-white sm:w-40 shrink-0">Registered Address:</dt>
          <dd class="text-muted dark:text-slate-400">[INSERT FULL RAKEZ REGISTERED ADDRESS]</dd>
        </div>
        <div class="flex flex-col sm:flex-row sm:gap-2">
          <dt class="font-semibold text-heading dark:text-white sm:w-40 shrink-0">Email:</dt>
          <dd class="text-muted dark:text-slate-400">
            <a href="mailto:info@bestvisual.ae" class="text-primary hover:underline">info@bestvisual.ae</a>
          </dd>
        </div>
        <div class="flex flex-col sm:flex-row sm:gap-2">
          <dt class="font-semibold text-heading dark:text-white sm:w-40 shrink-0">Phone:</dt>
          <dd class="text-muted dark:text-slate-400">
            <a href="tel:+97142544910" class="text-primary hover:underline">+971 4 254 4910</a>
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <!-- CTA -->
  <CallToAction
    title="Work with us"
    subtitle="Tell us about your project — we will outline the next steps within 24 business hours."
    actions={[
      {
        variant: 'primary',
        text: 'Get in touch',
        href: '/contact',
        icon: 'tabler:mail',
      },
    ]}
  />
</Layout>
