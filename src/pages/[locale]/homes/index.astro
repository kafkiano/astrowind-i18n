---
import Layout from '~/layouts/Layout.astro';
import { getCurrentLocale, getStaticPathsForLocale } from '~/utils/i18n';
export const getStaticPaths = getStaticPathsForLocale;

export const navigation = {
  // @wc-ignore
  title: 'Homes',
  type: 'group',
  showIn: 'header',
  order: 1,
};

const currentLocale = getCurrentLocale();
---

<meta http-equiv="refresh" content={`0;url=/${currentLocale}`} />

<Layout></Layout>
